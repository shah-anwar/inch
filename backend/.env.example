# Copy to backend/.env and fill in. Never commit the real .env.

# REQUIRED. PostgreSQL connection string. Prisma also reads this for
# `prisma generate` and `prisma migrate deploy`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# REQUIRED. Signs access tokens. Without it, login and every authenticated
# route return 401. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# OPTIONAL. Access token lifetime; clients refresh silently via POST /auth/refresh.
# JWT_ACCESS_EXPIRES=15m

# OPTIONAL. Days a refresh session may sit unused before the user must log in again.
# REFRESH_IDLE_DAYS=90

# REQUIRED for argument evaluation. Without Redis the API still starts, but the
# BullMQ evaluation worker does not, so new arguments stay UNDECIDED. Only the
# host and port are read by the worker.
REDIS_URL=redis://localhost:6379

# OPTIONAL. Mistral key for the LLM helpers. If unset (or a call fails):
#   - variable moderation fails open (input is allowed through)
#   - scheme suggestions come back empty
#   - text generation returns three deterministic template phrasings
# Argument status never depends on the LLM.
MISTRAL_API_KEY=

# OPTIONAL. Model id for the backend and the experiments harness.
# MISTRAL_MODEL=mistral-small-latest

# OPTIONAL, experiments only. Set to 1 to make `npm run exp:*` use deterministic
# mock responses instead of calling Mistral (also the behaviour when no key is set).
# EXPERIMENT_MOCK_MISTRAL=1

# OPTIONAL, load-test seed only. Depth of the synthetic 8-ary argument tree.
# LOAD_TEST_TREE_MAX_LEVEL=4

# Note: the server currently listens on port 3000 regardless of PORT
# (see src/server.ts), so PORT is not read.
