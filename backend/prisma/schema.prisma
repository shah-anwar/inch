generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArgumentStatus {
  IN
  OUT
  UNDECIDED
}

enum ParentType {
  SUBTOPIC
  ARGUMENT
}

model User {
  id        Int           @id @default(autoincrement())
  username  String        @unique
  email     String        @unique
  password  String
  isAdmin   Boolean       @default(false)
  arguments Argument[]
  sessions  UserSession[]
  createdAt DateTime      @default(now())
}

model UserSession {
  id        String   @id @default(cuid())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Topic {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  subtopics   Subtopic[]
  createdAt   DateTime   @default(now())
}

model Subtopic {
  id        Int        @id @default(autoincrement())
  topicId   Int
  title     String
  topic     Topic      @relation(fields: [topicId], references: [id])
  arguments Argument[]
  createdAt DateTime   @default(now())
}

model Scheme {
  id                String             @id
  name              String
  description       String
  conclusion        String
  variables         Json
  criticalQuestions CriticalQuestion[]
  activeScheme      ActiveScheme?
  arguments         Argument[]
  createdAt         DateTime          @default(now())
}

model ActiveScheme {
  schemeId  String   @id
  scheme    Scheme   @relation(fields: [schemeId], references: [id])
  createdAt DateTime @default(now())
}

model CriticalQuestion {
  id                     String     @id
  schemeId               String
  text                   String
  description            String
  validResponseSchemeIds String[]
  scheme                 Scheme     @relation(fields: [schemeId], references: [id])
  counterArguments       Argument[] @relation("ArgumentCQ")
}

model Argument {
  id               String           @id
  schemeId         String
  selectedCqId     String?
  argumentText     String
  isInitial        Boolean
  parentId         String?
  parentType       ParentType
  subtopicId       Int
  status           ArgumentStatus   @default(UNDECIDED)
  childIds         String[]         @default([])
  descendantCount  Int              @default(0)
  viewCount        Int              @default(0)
  authorId         Int
  scheme           Scheme           @relation(fields: [schemeId], references: [id])
  selectedCq       CriticalQuestion? @relation("ArgumentCQ", fields: [selectedCqId], references: [id])
  subtopic         Subtopic         @relation(fields: [subtopicId], references: [id])
  author           User             @relation(fields: [authorId], references: [id])
  variables        ArgumentVariable[]
  createdAt        DateTime         @default(now())
}

model ArgumentVariable {
  id         Int      @id @default(autoincrement())
  argumentId String
  variableId String
  value      String
  argument   Argument @relation(fields: [argumentId], references: [id])

  @@unique([argumentId, variableId])
}