{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": "./src",
    "paths": {
      "@db/*": ["db/*"],
      "@modules/*": ["modules/*"],
      "@inch/types": ["../../shared/types/src/index.ts"],
      "@inch/types/*": ["../../shared/types/src/*"]
    }
  },
  "include": ["src"]
}
